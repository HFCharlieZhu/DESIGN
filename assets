function itemHasCopyServer_(item) {
  if (!item) return false;
  if (item.typeId === 'product' || item.typeId === 'booth') return true;
  if (item.typeId === 'edm' || item.typeId === 'landing') {
    return (item.blocks || []).some(function(b) {
      return hasValue_(b && b.head) || hasValue_(b && b.sub) || hasValue_(b && b.small) || hasValue_(b && b.other);
    });
  }
  const c = item.copy || {};
  return hasValue_(c.head) || hasValue_(c.sub) || hasValue_(c.small) || hasValue_(c.other);
}


function isClosedStatusServer_(status) {
  return status === '完稿' || status === '結案' || status === '取消' || status === '退回';
}
function workingDaysBetweenIso_(fromIso, toIso) {
  if (!fromIso || !toIso || toIso <= fromIso) return 0;
  let d = new Date(fromIso + 'T00:00:00+08:00');
  const end = new Date(toIso + 'T00:00:00+08:00');
  let count = 0;
  while (d < end) {
    d.setDate(d.getDate() + 1);
    const wd = d.getDay();
    if (wd !== 0 && wd !== 6) count++;
  }
  return count;
}
function requestFlags_(obj) {
  const d = obj.data || {};
  const items = Array.isArray(d.items) ? d.items : [];
  const pending = items.some(function(item) { return !itemHasCopyServer_(item); });

  const error = !hasValue_(d.name) || !hasValue_(d.purpose) || !hasValue_(d.deliveryDate) || !items.length || items.some(function(item) {
    if (!item || VALID_TYPE_IDS.indexOf(item.typeId) === -1) return true;
    const outputRequired = ['product','booth','edm','landing','print'].indexOf(item.typeId) === -1;
    if (outputRequired && (!Array.isArray(item.output) || !item.output.length)) return true;
    if ((item.typeId === 'print' || (item.output || []).indexOf('print') >= 0) && !hasValue_(item.printQty)) return true;
    return false;
  });

  const today = Utilities.formatDate(new Date(), CONFIG_TIMEZONE_(), 'yyyy-MM-dd');
  const delivery = dateOnly_(d.deliveryDate);
  const closed = isClosedStatusServer_(obj.status);
  const overdue = !!delivery && !closed && delivery < today;
  const urgent = !!delivery && !closed && delivery >= today && workingDaysBetweenIso_(today, delivery) < 5;

  return {pending: pending, error: error, overdue: overdue, urgent: urgent};
}


