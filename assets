function encodeExampleBaseline_(value) {
  const json = JSON.stringify(value || {});
  const gz = Utilities.gzip(Utilities.newBlob(json, 'application/json'));
  return Utilities.base64Encode(gz.getBytes());
}

function decodeExampleBaseline_(value) {
  if (!value) return {};
  try {
    const bytes = Utilities.base64Decode(String(value));
    const json = Utilities.ungzip(Utilities.newBlob(bytes)).getDataAsString('UTF-8');
    return JSON.parse(json);
  } catch (err) {
    return {};
  }
}

function restoreExampleBlankStrings_(incoming, baseline, path, restored) {
  path = path || '';
  restored = restored || [];
  if (typeof baseline === 'string') {
    const current = incoming === null || incoming === undefined ? '' : String(incoming);
    if (baseline.trim() && !current.trim()) {
      restored.push(path);
      return baseline;
    }
    return incoming;
  }
  if (Array.isArray(baseline)) {
    if (!Array.isArray(incoming)) return incoming;
    return incoming.map(function(item, index) {
      let baseItem = null;
      if (item && typeof item === 'object' && item._id) {
        baseItem = baseline.find(function(x) { return x && typeof x === 'object' && x._id === item._id; }) || null;
      }
      if (!baseItem && index < baseline.length) baseItem = baseline[index];
      return baseItem === null || baseItem === undefined
        ? item
        : restoreExampleBlankStrings_(item, baseItem, path + '[' + index + ']', restored);
    });
  }
  if (baseline && typeof baseline === 'object') {
    const out = incoming && typeof incoming === 'object' && !Array.isArray(incoming)
      ? Object.assign({}, incoming)
      : {};
    Object.keys(baseline).forEach(function(key) {
      if (!Object.prototype.hasOwnProperty.call(out, key)) return;
      out[key] = restoreExampleBlankStrings_(out[key], baseline[key], path ? path + '.' + key : key, restored);
    });
    return out;
  }
  return incoming;
}

function validateRequest_(data) {
