function findRequestIndex_(table, requestId) {
  const idx = table.map.requestId;
  if (idx === undefined) return -1;
  for (let i = 0; i < table.rows.length; i++) if (String(table.rows[i][idx] || '').trim() === requestId) return i;
  return -1;
}

function generateRequestIdFromTable_(table, department, initials, email) {
  const h = table.map;
  let maxSequence = 0;
  const existing = {};
  table.rows.forEach(function(row) {
    const id = String(cell_(row, h, 'requestId') || '');
    if (id) existing[id] = true;
    if (String(cell_(row, h, 'department') || '') === department && String(cell_(row, h, 'applicantEmail') || '').toLowerCase() === email.toLowerCase()) {
      const m = id.match(/-(\d{4})$/);
      if (m) maxSequence = Math.max(maxSequence, Number(m[1]));
    }
  });
  let sequence = maxSequence + 1;
  let candidate = department + '-' + initials + '-' + String(sequence).padStart(4, '0');
  while (existing[candidate]) {
    sequence++;
    candidate = department + '-' + initials + '-' + String(sequence).padStart(4, '0');
  }
  return candidate;
}

function findCreateOperation_(table, operationId, email) {
  if (!operationId || table.map.operationId === undefined) return -1;
  for (let i = 0; i < table.rows.length; i++) {
    if (String(cell_(table.rows[i], table.map, 'operationId') || '') === operationId && String(cell_(table.rows[i], table.map, 'applicantEmail') || '').toLowerCase() === String(email || '').toLowerCase()) return i;
  }
  return -1;
}

function setRowValue_(row, map, name, value) {
  if (map[name] !== undefined) row[map[name]] = value;
}

function createRequest_(user, rawData, operationId) {
  validateUser_(user);
  const data = normalizeRequestData_(rawData);
  if (!data.department) data.department = getInitials_(user.name);
  validateRequest_(data);
  validateRequestDetails_(data);
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const sheet = ss.getSheetByName(CONFIG.REQUESTS_SHEET);
  const logsSheet = ss.getSheetByName(CONFIG.LOGS_SHEET);
  if (!sheet || !logsSheet) throw new Error('找不到 Requests 或 Logs 工作表');
  ensureOptionalColumns_(sheet);
  operationId = safeString_(operationId, 120);
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  let docId = '';
  try {
    const table = readRequestsTable_(sheet);
    const existingOperationIndex = findCreateOperation_(table, operationId, user.email);
    if (existingOperationIndex >= 0) {
      const existing = rowToRequest_(table.rows[existingOperationIndex], table.map, []);
      return {requestId: existing.id, docId: existing.docId, docUrl: existing.docUrl, request: existing, summary: requestSummary_(existing), logsSheet: logsSheet, duplicate: true};
    }
    const requestId = generateRequestIdFromTable_(table, data.department, getInitials_(user.name), user.email);
    const now = new Date();
    const html = buildReadableDocumentHtml_(requestId, user, data, now);
    const file = Drive.Files.create({name: requestId + '｜' + data.name, mimeType: 'application/vnd.google-apps.document', parents: [CONFIG.FOLDER_ID]}, Utilities.newBlob(html, 'text/html', requestId + '.html'), {fields: 'id,name,mimeType'});
    docId = file.id;
    const docUrl = 'https://docs.google.com/document/d/' + docId + '/edit';
    const row = new Array(table.lastCol).fill('');
    const values = {
      requestId: requestId, submittedAt: now, updatedAt: now, status: '待確認', department: data.department,
      applicantName: user.name, applicantEmail: user.email, name: data.name, purpose: data.purpose, message: data.message,
      audience: data.audience, note1: data.note1, note2: data.note2, deliveryDate: data.deliveryDate, scheduleNote: data.scheduleNote,
      refLinks: JSON.stringify(data.refLinks), refNote: data.refNote, items: JSON.stringify(data.items), docId: docId, docUrl: docUrl, meetingDate: '', operationId: operationId,
      isExample: false, exampleBaseline: ''
    };
    Object.keys(values).forEach(function(name) { setRowValue_(row, table.map, name, values[name]); });
    sheet.getRange(sheet.getLastRow() + 1, 1, 1, table.lastCol).setValues([row]);
    logsSheet.getRange(logsSheet.getLastRow() + 1, 1, 1, 5).setValues([[requestId, now, user.email, 'CREATE', '建立設計需求']]);
    invalidateRequestCaches_(requestId);
    const obj = rowToRequest_(row, table.map, [{time: now.toISOString(), user: user.email, action: 'CREATE', text: '建立設計需求'}]);
    return {requestId: requestId, docId: docId, docUrl: docUrl, request: obj, summary: requestSummary_(obj), logsSheet: logsSheet};
  } catch (err) {
    if (docId) try { Drive.Files.remove(docId); } catch (cleanupErr) { console.error(cleanupErr); }
    throw err;
  } finally {
    lock.releaseLock();
  }
}

function listRequests_() {
