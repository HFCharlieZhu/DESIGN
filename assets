function escHtml_(value) {
  return String(value === null || value === undefined ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function escHtmlWithBreaks_(value) {
  return escHtml_(value).replace(/\n/g, '<br>');
}

function pushRow_(rows, label, value) {
  if (hasValue_(value)) {
    rows.push([label, value]);
  }
}

function hasValue_(value) {
  if (value === null || value === undefined) return false;
  if (Array.isArray(value)) return value.length > 0;
  return String(value).trim() !== '';
}

function display_(value, fallback) {
  if (!hasValue_(value)) {
    return fallback || '—';
  }

  return String(value);
}

function hasCopy_(copy) {
  return hasValue_(copy.head) ||
    hasValue_(copy.sub) ||
    hasValue_(copy.small) ||
    hasValue_(copy.other);
}

function hasBlockContent_(block) {
  if (!block) return false;

  return hasValue_(block.head) ||
    hasValue_(block.sub) ||
    hasValue_(block.small) ||
    hasValue_(block.other) ||
    hasValue_(block.imgNote) ||
    hasValue_(block.link);
}

function normalizeRefLinks_(links) {
  return (links || []).map(function(link) {
    if (typeof link === 'string') {
      return link.trim();
    }

    if (link && typeof link === 'object') {
      const url = String(link.url || '').trim();
      const note = String(link.note || '').trim();

      if (url && note) {
        return url + '\n' + note;
      }

      return url || note;
    }

    return '';
  }).filter(Boolean);
}

