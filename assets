    if (!item || VALID_TYPE_IDS.indexOf(item.typeId) === -1) throw new Error('項目 ' + (index + 1) + ' 的需求類型無效');
    const special = item.typeId === 'product' || item.typeId === 'booth' || item.typeId === 'edm' || item.typeId === 'landing' || item.typeId === 'print';
    if (!special && (!Array.isArray(item.output) || !item.output.length)) throw new Error('項目 ' + (index + 1) + ' 缺少輸出形式');
    if ((item.typeId === 'print' || (item.output || []).indexOf('print') >= 0) && !hasValue_(item.printQty)) throw new Error('項目 ' + (index + 1) + ' 缺少印刷數量');
  });
}
function safeString_(value, maxLength) {
  const text = String(value === null || value === undefined ? '' : value).trim();
  return text.slice(0, maxLength || 20000);
}

function normalizeTypographyText_(value) {
  let text = String(value === null || value === undefined ? '' : value);
  if (!text) return text;
  const saved = [];
  text = text.replace(/(?:https?:\/\/|www\.)[^\s<>"']+|[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi, function(token) {
    const key = 'XPROTECTED' + saved.length + 'X';saved.push(token);return key;
  });
  const cjk = '\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uF900-\\uFAFF';
  text = text.replace(new RegExp('([' + cjk + '])([A-Za-z0-9])', 'g'), '$1 $2');
  text = text.replace(new RegExp('([A-Za-z0-9])([' + cjk + '])', 'g'), '$1 $2');
  const fullMap = {',':'，','.':'。',';':'；',':':'：','?':'？','!':'！'};
  const halfMap = {'，':',','。':'.','；':';','：':':','？':'?','！':'!'};
  text = text.replace(new RegExp('([' + cjk + '])([,.;:?!])', 'g'), function(_, a, p) { return a + fullMap[p]; });
  text = text.replace(new RegExp('([,.;:?!])([' + cjk + '])', 'g'), function(_, p, b) { return fullMap[p] + b; });
  text = text.replace(/([A-Za-z0-9])([，。；：？！])/g, function(_, a, p) { return a + halfMap[p]; });
  text = text.replace(/([，。；：？！])([A-Za-z0-9])/g, function(_, p, b) { return halfMap[p] + b; });
  text = text.replace(/([A-Za-z])([,.;:?!])(?=[A-Za-z0-9])/g, '$1$2 ');
  text = text.replace(/([A-Za-z0-9])([,;:?!])(?=[A-Za-z])/g, '$1$2 ');
  text = text.replace(/[ \t]{2,}/g, ' ');
  saved.forEach(function(token, i) { text = text.replace('XPROTECTED' + i + 'X', token); });
  return text;
}
function safeTypographyString_(value, maxLength) {
