function addHtmlSection_(parts, title) {
  parts.push('<h2>' + escHtml_(title) + '</h2>');
}

function addHtmlTextBlock_(parts, label, value) {
  if (!hasValue_(value)) return;
  parts.push('<div class="label">' + escHtml_(label) + '</div>');
  parts.push('<div class="text">' + escHtmlWithBreaks_(String(value)) + '</div>');
}

function addHtmlKeyValueTable_(parts, rows) {
  const clean = (rows || []).filter(function(row) {
    return row && row.length >= 2 && hasValue_(row[1]);
  });
  if (!clean.length) return;

  parts.push('<table><tbody>');
  clean.forEach(function(row) {
    parts.push(
      '<tr><td class="key" width="50%">' +
      escHtml_(row[0]) +
      '</td><td width="50%">' +
      escHtmlWithBreaks_(display_(row[1])) +
      '</td></tr>'
    );
  });
  parts.push('</tbody></table>');
}

function addHtmlGridTable_(parts, rows) {
  if (!rows || !rows.length) return;

  parts.push('<table>');
  parts.push('<thead><tr>');
  rows[0].forEach(function(value) {
    parts.push('<th>' + escHtml_(display_(value)) + '</th>');
  });
  parts.push('</tr></thead><tbody>');

  rows.slice(1).forEach(function(row) {
    parts.push('<tr>');
    row.forEach(function(value) {
      parts.push('<td>' + escHtmlWithBreaks_(display_(value)) + '</td>');
    });
    parts.push('</tr>');
  });

  parts.push('</tbody></table>');
}

