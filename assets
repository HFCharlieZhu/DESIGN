function updateRequest_(user, payload) {
  validateUser_(user);
  const requestId = safeString_(payload.requestId, 100);
  if (!requestId) throw new Error('Missing requestId');
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const sheet = ss.getSheetByName(CONFIG.REQUESTS_SHEET);
  const logsSheet = ss.getSheetByName(CONFIG.LOGS_SHEET);
  if (!sheet || !logsSheet) throw new Error('找不到 Requests 或 Logs 工作表');
  ensureOptionalColumns_(sheet);
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  let newDocId = '';
  try {
    const table = readRequestsTable_(sheet);
    const index = findRequestIndex_(table, requestId);
    if (index < 0) throw new Error('找不到案件：' + requestId);
    const oldRow = table.rows[index];
    const oldObj = rowToRequest_(oldRow, table.map, []);
    requireCanEditRequest_(user, oldObj);
    let data = normalizeRequestData_(payload.data || oldObj.data);
    let exampleRestoredFields = [];
    if (oldObj.isExample) {
      const baselinePayload = decodeExampleBaseline_(cell_(oldRow, table.map, 'exampleBaseline'));
      const baselineData = baselinePayload && baselinePayload.data ? baselinePayload.data : {};
      data = restoreExampleBlankStrings_(data, baselineData, 'data', exampleRestoredFields);
      data.department = 'EX';
    }
    if (!data.department) data.department = oldObj.data.department;
    validateRequest_(data);
    validateRequestDetails_(data);
    const status = VALID_STATUSES.indexOf(payload.status) >= 0 ? payload.status : oldObj.status;
    let meetingDate = Object.prototype.hasOwnProperty.call(payload, 'meetingDate') ? safeString_(payload.meetingDate, 30) : oldObj.meetingDate;
    if (oldObj.isExample) {
      const baselinePayloadForMeet = decodeExampleBaseline_(cell_(oldRow, table.map, 'exampleBaseline'));
      const baselineMeeting = safeString_(baselinePayloadForMeet && baselinePayloadForMeet.meetingDate, 30);
      if (baselineMeeting && !meetingDate) {
        meetingDate = baselineMeeting;
        exampleRestoredFields.push('meetingDate');
      }
    }
    const now = new Date();
    const contentChanged = JSON.stringify(documentData_(oldObj.data)) !== JSON.stringify(documentData_(data));
    let docId = oldObj.docId;
    let docUrl = oldObj.docUrl;
    if (contentChanged) {
      const html = buildReadableDocumentHtml_(requestId, oldObj.submitter, data, oldObj.submittedAt || now);
      const file = Drive.Files.create({name: requestId + '｜' + data.name, mimeType: 'application/vnd.google-apps.document', parents: [CONFIG.FOLDER_ID]}, Utilities.newBlob(html, 'text/html', requestId + '.html'), {fields: 'id,name,mimeType'});
      newDocId = file.id;
      docId = newDocId;
      docUrl = 'https://docs.google.com/document/d/' + docId + '/edit';
    }
    const row = oldRow.slice();
    const values = {
      updatedAt: now, status: status, department: data.department, name: data.name, purpose: data.purpose, message: data.message,
      audience: data.audience, note1: data.note1, note2: data.note2, deliveryDate: data.deliveryDate, scheduleNote: data.scheduleNote,
      refLinks: JSON.stringify(data.refLinks), refNote: data.refNote, items: JSON.stringify(data.items), meetingDate: meetingDate, docId: docId, docUrl: docUrl
    };
    Object.keys(values).forEach(function(name) { setRowValue_(row, table.map, name, values[name]); });
    sheet.getRange(index + 2, 1, 1, table.lastCol).setValues([row]);
    invalidateRequestCaches_(requestId);
    const labels = Array.isArray(payload.labels) && payload.labels.length ? payload.labels.slice(0, 20) : ['內容更新'];
    if (exampleRestoredFields.length) labels.push('範例空白欄位自動恢復');
    const logRows = labels.map(function(label) { return [requestId, now, user.email, 'UPDATE', safeString_(label, 500)]; });
    if (logRows.length) logsSheet.getRange(logsSheet.getLastRow() + 1, 1, logRows.length, 5).setValues(logRows);
    if (contentChanged && oldObj.docId) try { Drive.Files.remove(oldObj.docId); } catch (err) { console.error(err); }
    newDocId = '';
    const request = rowToRequest_(row, table.map, []);
    const logs = logRows.map(function(r) { return {time: now.toISOString(), user: user.email, action: 'UPDATE', text: String(r[4])}; });
    return {
      request: request,
      summary: requestSummary_(request),
      logs: logs,
      documentUpdated: contentChanged,
      logsSheet: logsSheet,
      exampleRestored: exampleRestoredFields.length > 0,
      restoredFields: exampleRestoredFields
    };
  } catch (err) {
    if (newDocId) try { Drive.Files.remove(newDocId); } catch (cleanupErr) { console.error(cleanupErr); }
    throw err;
  } finally {
    lock.releaseLock();
  }
}

function docxXmlEsc_(value) {
  return String(value === null || value === undefined ? '' : value)
    .replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g, '')
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function docxRun_(text, options) {
  options = options || {};
  const ds = DOCUMENT_STYLE;
  const size = options.size === undefined ? halfPoint_(ds.bodyPt) : options.size;
  const color = options.color || ds.text;
  const props = '<w:rPr><w:rFonts w:ascii="' + ds.fontLatin + '" w:hAnsi="' + ds.fontLatin + '" w:eastAsia="' + ds.fontCjk + '"/>' +
    (options.bold ? '<w:b/>' : '') +
    '<w:sz w:val="' + size + '"/><w:szCs w:val="' + size + '"/>' +
    '<w:color w:val="' + color + '"/>' +
    '<w:lang w:val="zh-TW" w:eastAsia="zh-TW"/></w:rPr>';
  const pieces = String(text === null || text === undefined ? '' : text).split(/\r?\n/);
  let body = '';
  pieces.forEach(function(piece, i) {
    if (i) body += '<w:br/>';
    body += '<w:t xml:space="preserve">' + docxXmlEsc_(piece) + '</w:t>';
  });
  return '<w:r>' + props + body + '</w:r>';
}

function docxParagraph_(text, options) {
  options = options || {};
  const before = options.before || 0;
  const after = options.after === undefined ? 0 : options.after;
  const keep = options.keepNext ? '<w:keepNext/>' : '';
  const align = options.align ? '<w:jc w:val="' + options.align + '"/>' : '';
  const line = options.line ? '<w:spacing w:before="' + before + '" w:after="' + after + '" w:line="' + options.line + '" w:lineRule="auto"/>' :
    '<w:spacing w:before="' + before + '" w:after="' + after + '"/>';
  return '<w:p><w:pPr>' + keep + align + line + '</w:pPr>' + docxRun_(text, options) + '</w:p>';
}

function docxCell_(value, options) {
  options = options || {};
  const ds = DOCUMENT_STYLE;
  const width = options.width || 0;
  const fill = options.fill ? '<w:shd w:fill="' + options.fill + '"/>' : '';
  return '<w:tc><w:tcPr>' +
    (width ? '<w:tcW w:w="' + width + '" w:type="dxa"/>' : '') +
    fill +
    '<w:tcMar><w:top w:w="' + twip_(ds.tablePadVerticalPt) + '" w:type="dxa"/><w:left w:w="' + twip_(ds.tablePadHorizontalPt) + '" w:type="dxa"/><w:bottom w:w="' + twip_(ds.tablePadVerticalPt) + '" w:type="dxa"/><w:right w:w="' + twip_(ds.tablePadHorizontalPt) + '" w:type="dxa"/></w:tcMar></w:tcPr>' +
    docxParagraph_(display_(value), {
      bold: !!options.bold,
      size: halfPoint_(ds.metaPt),
      color: options.color || ds.text,
      after: 0,
      line: Math.round(ds.metaPt * 1.25 * 20)
    }) +
    '</w:tc>';
}

function docxTableShell_(gridWidths, rowsXml) {
  const ds = DOCUMENT_STYLE;
  const total = gridWidths.reduce(function(sum, n) { return sum + n; }, 0);
  const border = '<w:tblBorders><w:top w:val="single" w:sz="6" w:color="' + ds.tableBorder + '"/><w:left w:val="single" w:sz="6" w:color="' + ds.tableBorder + '"/><w:bottom w:val="single" w:sz="6" w:color="' + ds.tableBorder + '"/><w:right w:val="single" w:sz="6" w:color="' + ds.tableBorder + '"/><w:insideH w:val="single" w:sz="6" w:color="' + ds.tableBorder + '"/><w:insideV w:val="single" w:sz="6" w:color="' + ds.tableBorder + '"/></w:tblBorders>';
  const grid = gridWidths.map(function(w) { return '<w:gridCol w:w="' + w + '"/>'; }).join('');
  return '<w:p><w:pPr><w:spacing w:before="' + pxToTwip_(8) + '" w:after="0"/></w:pPr></w:p>' +
    '<w:tbl><w:tblPr><w:tblW w:w="' + total + '" w:type="dxa"/><w:tblLayout w:type="fixed"/>' + border + '</w:tblPr><w:tblGrid>' + grid + '</w:tblGrid>' + rowsXml + '</w:tbl>' +
    '<w:p><w:pPr><w:spacing w:before="0" w:after="' + pxToTwip_(18) + '"/></w:pPr></w:p>';
}

function docxKeyValueTable_(rows) {
  if (!rows || !rows.length) return '';
  const ds = DOCUMENT_STYLE;
  const contentWidth = 11906 - (twip_(ds.pageMarginPt) * 2);
  const keyWidth = Math.round(contentWidth * ds.tableKeyPercent / 100);
  const valueWidth = contentWidth - keyWidth;
  let rowsXml = '';
  rows.forEach(function(row) {
    rowsXml += '<w:tr>' +
      docxCell_(row[0], {width:keyWidth,fill:ds.tableFill,bold:true,color:ds.text}) +
      docxCell_(row[1], {width:valueWidth,bold:false,color:ds.text}) +
      '</w:tr>';
  });
  return docxTableShell_([keyWidth, valueWidth], rowsXml);
}

function docxGridTable_(rows) {
  if (!rows || !rows.length || !rows[0].length) return '';
  const ds = DOCUMENT_STYLE;
  const contentWidth = 11906 - (twip_(ds.pageMarginPt) * 2);
  const count = rows[0].length;
  const base = Math.floor(contentWidth / count);
  const widths = Array(count).fill(base);
  widths[count - 1] += contentWidth - base * count;
  let rowsXml = '';
  rows.forEach(function(row, rowIndex) {
    rowsXml += '<w:tr>';
    for (let i = 0; i < count; i++) {
      rowsXml += docxCell_(row[i], {
        width: widths[i],
        fill: rowIndex === 0 ? ds.tableFill : '',
        bold: rowIndex === 0,
        color: ds.text
      });
    }
    rowsXml += '</w:tr>';
  });
  return docxTableShell_(widths, rowsXml);
}

function docxSection_(title) {
  const ds = DOCUMENT_STYLE;
  return docxParagraph_(title, {
    bold:true,
    size:halfPoint_(ds.sectionPt),
    color:ds.text,
    before:pxToTwip_(24),
    after:pxToTwip_(12),
    keepNext:true,
    line:Math.round(ds.sectionPt * 1.2 * 20)
  });
}

function docxLabelText_(label, value) {
  if (!hasValue_(value)) return '';
  const ds = DOCUMENT_STYLE;
  return docxParagraph_(label, {
    bold:true,
    size:halfPoint_(ds.metaPt),
    color:ds.muted,
    before:pxToTwip_(14),
    after:pxToTwip_(2),
    keepNext:true,
    line:Math.round(ds.metaPt * 1.2 * 20)
  }) + docxParagraph_(value, {
    size:halfPoint_(ds.bodyPt),
    color:ds.text,
    after:pxToTwip_(12),
    line:Math.round(ds.bodyPt * ds.bodyLine * 20)
  });
}

function docxSubsection_(title) {
  const ds = DOCUMENT_STYLE;
  return docxParagraph_(title, {
    bold:true,
    size:halfPoint_(ds.subsectionPt),
    color:ds.text,
    before:pxToTwip_(20),
    after:pxToTwip_(8),
    keepNext:true,
    line:Math.round(ds.subsectionPt * 1.2 * 20)
  });
}

function buildLeanRequestDocx_(obj, fileName) {
  const ds = DOCUMENT_STYLE;
  const d = obj.data || {};
  let body = '';

  body += docxParagraph_('設計需求申請', {
    bold:true,size:halfPoint_(ds.titlePt),color:ds.text,after:pxToTwip_(2),keepNext:true,
    line:Math.round(ds.titlePt * 1.1 * 20)
  });
  body += docxParagraph_(obj.id, {
    bold:true,size:halfPoint_(ds.requestIdPt),color:ds.requestId,after:pxToTwip_(2),keepNext:true,
    line:Math.round(ds.requestIdPt * 1.15 * 20)
  });
  body += docxParagraph_(d.name || '未命名需求', {
    bold:true,size:halfPoint_(ds.requestNamePt),color:ds.text,after:pxToTwip_(34),
    line:Math.round(ds.requestNamePt * 1.15 * 20)
  });

  body += docxSection_('案件資訊');
  body += docxKeyValueTable_([
    ['申請人', obj.submitter.name],
    ['Email', obj.submitter.email],
    ['分組', d.department || d.dept],
    ['申請時間', formatDateTime_(obj.submittedAt || new Date())],
    ['總交付日', formatDate_(d.deliveryDate)]
  ]);

  body += docxSection_('需求概述');
  body += docxLabelText_('需求背景／說明', d.purpose);
  body += docxLabelText_('主要訊息／方向', d.message);
  const overview = [];
  pushRow_(overview, '目標對象', d.audience);
  pushRow_(overview, '備註 1', d.note1);
  pushRow_(overview, '備註 2', d.note2);
  if (overview.length) body += docxKeyValueTable_(overview);

  body += docxSection_('設計項目');
  (d.items || []).forEach(function(item, index) {
    body += docxParagraph_(String(index + 1).padStart(2, '0') + '｜' + display_(item.name, '未命名項目'), {
      bold:true,size:halfPoint_(ds.itemPt),color:ds.text,before:pxToTwip_(28),after:pxToTwip_(2),keepNext:true,
      line:Math.round(ds.itemPt * 1.2 * 20)
    });

    const type = typeLabel_(item.typeId);
    if (type) {
      body += docxParagraph_(type, {
        bold:true,size:halfPoint_(ds.metaPt),color:ds.muted,after:pxToTwip_(14),keepNext:true,
        line:Math.round(ds.metaPt * 1.2 * 20)
      });
    }

    const basicRows = [];
    pushRow_(basicRows, '需求類型', type);
    pushRow_(basicRows, '輸出形式', outputLabel_(item.output));
    pushRow_(basicRows, '頁面／用途', item.page);
    pushRow_(basicRows, '平台', platformLabel_(item.platform));
    pushRow_(basicRows, '渠道', item.channel);
    pushRow_(basicRows, '頁數', item.pagecount);
    pushRow_(basicRows, '使用日期', formatDate_(item.useDate));
    pushRow_(basicRows, '商品曝光', exposureLabel_(item.exposure));
    pushRow_(basicRows, '商品型號', item.exposureModel);
    if (basicRows.length) body += docxKeyValueTable_(basicRows);

    const sizes = (item.sizeRows || []).filter(function(row) {
      return hasValue_(row.purpose) || hasValue_(row.customText) || hasValue_(row.px);
    });
    if (sizes.length) {
      body += docxSubsection_('尺寸／規格');
      const sizeRows = [['用途', '自訂說明', '尺寸']];
      sizes.forEach(function(row) {
        sizeRows.push([display_(row.purpose), display_(row.customText), display_(row.px)]);
      });
      body += docxGridTable_(sizeRows);
    }

    if (hasValue_(item.printQty)) {
      body += docxKeyValueTable_([['印刷數量', item.printQty]]);
    }

    if (item.copy && hasCopy_(item.copy)) {
      body += docxSubsection_('文案');
      const copyRows = [];
      pushRow_(copyRows, '大標', item.copy.head);
      pushRow_(copyRows, '副標', item.copy.sub);
      pushRow_(copyRows, '小字', item.copy.small);
      pushRow_(copyRows, '其他文案', item.copy.other);
      body += docxKeyValueTable_(copyRows);
    }

    if (hasValue_(item.cta)) {
      body += docxKeyValueTable_([['CTA／行動文字', item.cta]]);
    }

    const blocks = (item.blocks || []).filter(hasBlockContent_);
    if (blocks.length) {
      body += docxSubsection_('內容區塊');
      blocks.forEach(function(block, blockIndex) {
        body += docxParagraph_('區塊 ' + String(blockIndex + 1).padStart(2, '0'), {
          bold:true,size:halfPoint_(ds.metaPt),color:ds.muted,
          before:pxToTwip_(14),after:pxToTwip_(2),keepNext:true,
          line:Math.round(ds.metaPt * 1.2 * 20)
        });
        const blockRows = [];
        pushRow_(blockRows, '大標', block.head);
        pushRow_(blockRows, '副標', block.sub);
        pushRow_(blockRows, '小字', block.small);
        pushRow_(blockRows, '其他文案', block.other);
        pushRow_(blockRows, '圖片說明', block.imgNote);
        pushRow_(blockRows, 'CTA／連結', block.link);
        if (blockRows.length) body += docxKeyValueTable_(blockRows);
      });
    }

    body += docxLabelText_('設計備註', item.note);
  });

  body += docxSection_('素材與參考');
  const links = normalizeRefLinks_(d.refLinks);
  body += docxKeyValueTable_(links.length ? links.map(function(link, index) {
    return [links.length > 1 ? '參考連結 ' + (index + 1) : '參考連結', link];
  }) : [['參考連結', '無']]);
  body += docxLabelText_('參考資料備註', d.refNote || '無');

  body += docxSection_('時程');
  body += docxKeyValueTable_([
    ['總交付日', formatDate_(d.deliveryDate)],
    ['時程備註', display_(d.scheduleNote, '無')]
  ]);

  body += docxParagraph_(
    '案件編號：' + obj.id + '　｜　建立時間：' + formatDateTime_(obj.submittedAt || new Date()),
    {
      size:halfPoint_(ds.footerPt),color:ds.footer,before:pxToTwip_(30),after:0,align:'right',
      line:Math.round(ds.footerPt * 1.2 * 20)
    }
  );

  const margin = twip_(ds.pageMarginPt);
  const documentXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body>' +
    body +
    '<w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="' + margin + '" w:right="' + margin + '" w:bottom="' + margin + '" w:left="' + margin + '" w:header="720" w:footer="720" w:gutter="0"/></w:sectPr></w:body></w:document>';

  const stylesXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="' + ds.fontLatin + '" w:hAnsi="' + ds.fontLatin + '" w:eastAsia="' + ds.fontCjk + '"/><w:sz w:val="' + halfPoint_(ds.bodyPt) + '"/><w:szCs w:val="' + halfPoint_(ds.bodyPt) + '"/><w:lang w:val="zh-TW" w:eastAsia="zh-TW"/></w:rPr></w:rPrDefault><w:pPrDefault><w:pPr><w:spacing w:after="0" w:line="' + Math.round(ds.bodyPt * ds.bodyLine * 20) + '" w:lineRule="auto"/></w:pPr></w:pPrDefault></w:docDefaults><w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/><w:qFormat/></w:style></w:styles>';

  const docRels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>';
  const nowIso = new Date().toISOString();
  const coreXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:dcmitype="http://purl.org/dc/dcmitype/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dc:title>' + docxXmlEsc_(obj.id + ' ' + (d.name || '設計需求')) + '</dc:title><dc:creator>PATRONI 平面設計需求系統</dc:creator><cp:lastModifiedBy>PATRONI 平面設計需求系統</cp:lastModifiedBy><dcterms:created xsi:type="dcterms:W3CDTF">' + nowIso + '</dcterms:created><dcterms:modified xsi:type="dcterms:W3CDTF">' + nowIso + '</dcterms:modified></cp:coreProperties>';
  const appXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties" xmlns:vt="http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes"><Application>PATRONI 平面設計需求系統</Application><AppVersion>1.0</AppVersion></Properties>';
  const rootRels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties" Target="docProps/core.xml"/><Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties" Target="docProps/app.xml"/></Relationships>';
  const contentTypes = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/><Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/><Override PartName="/docProps/core.xml" ContentType="application/vnd.openxmlformats-package.core-properties+xml"/><Override PartName="/docProps/app.xml" ContentType="application/vnd.openxmlformats-officedocument.extended-properties+xml"/></Types>';

  const zipped = Utilities.zip([
    Utilities.newBlob(contentTypes,'application/xml','[Content_Types].xml'),
    Utilities.newBlob(rootRels,'application/xml','_rels/.rels'),
    Utilities.newBlob(coreXml,'application/xml','docProps/core.xml'),
    Utilities.newBlob(appXml,'application/xml','docProps/app.xml'),
    Utilities.newBlob(documentXml,'application/xml','word/document.xml'),
    Utilities.newBlob(stylesXml,'application/xml','word/styles.xml'),
    Utilities.newBlob(docRels,'application/xml','word/_rels/document.xml.rels')
  ], fileName);

  const bytes = zipped.getBytes();
  if (bytes.length > CONFIG.MAX_WORD_BYTES) {
    throw new Error('Word 附件大小異常（' + Math.round(bytes.length / 1024) + ' KB）');
  }
  return Utilities.newBlob(bytes, DOCX_MIME, fileName);
}

function safeFileName_(value) {
  return safeString_(value, 180).replace(/[\\/:*?"<>|\u0000-\u001f]/g, '_') || '設計需求';
}

function requestMailRecipients_(applicant) {
  const to = String(CONFIG.REQUEST_MAIL_TO || '').trim().toLowerCase();
  if (!to || !to.endsWith('@' + ALLOWED_DOMAIN)) throw new Error('需求通知主收件者設定無效');
  const ccSet = new Set();
  [applicant].concat(CONFIG.REQUEST_MAIL_CC || []).forEach(function(value) {
    const email = String(value || '').trim().toLowerCase();
    if (email && email.endsWith('@' + ALLOWED_DOMAIN) && email !== to) ccSet.add(email);
  });
  return {to: to, cc: Array.from(ccSet)};
}

function appendLog_(logsSheet, requestId, userEmail, action, detail) {
  const now = new Date();
  logsSheet.getRange(logsSheet.getLastRow() + 1, 1, 1, 5).setValues([[requestId, now, userEmail, action, detail]]);
  return {time: now.toISOString(), user: userEmail, action: action, text: detail};
}

function sendRequestNotificationFromObject_(user, obj, mode, logsSheet) {
  const applicant = String(obj.submitter.email || '').trim().toLowerCase();
  if (!applicant || !applicant.endsWith('@' + ALLOWED_DOMAIN)) throw new Error('申請人信箱不是有效的公司信箱');
  const recipients = requestMailRecipients_(applicant);
  const fileName = safeFileName_(obj.id + '｜' + (obj.data.name || '設計需求')) + '.docx';
  const wordBlob = buildLeanRequestDocx_(obj, fileName);
  const isResend = mode === 'resend';
  const subject = (isResend ? '【設計需求｜重新發送】' : '【設計需求｜新申請】') + obj.id + '｜' + (obj.data.name || '未命名需求');
  const body = [
    '您好，', '',
    isResend ? '此案件的設計需求已更新，相關資訊如下：' : '您的設計需求已建立，相關資訊如下：', '',
    '案件編號：' + obj.id,
    '需求名稱：' + (obj.data.name || ''),
    '申請人：' + getInitials_(obj.submitter.name || obj.submitter.email) + '<' + (obj.submitter.email || '') + '>',
    '案件狀態：' + (obj.status || ''),
    '總交付日：' + (obj.data.deliveryDate || ''), '',
    isResend ? '本信件附有最新版本 Word 需求表，請以附件內容為準。' : '本信件附有 Word 需求表，請以附件內容為準。', '',
    '謝謝您。',
    'PATRONI 平面設計需求系統', '',
    '此信件由平面設計需求系統自動發送。'
  ].join('\n');
  const mailOptions = {to: recipients.to, subject: subject, body: body, attachments: [wordBlob], name: 'PATRONI 平面設計需求系統'};
  if (recipients.cc.length) mailOptions.cc = recipients.cc.join(',');
  MailApp.sendEmail(mailOptions);
  const detail = (isResend ? '重新發送需求通知：' : '寄送新需求通知：') +
    '收件者 ' + recipients.to +
    (recipients.cc.length ? '；副本 ' + recipients.cc.join(', ') : '');
  return {
    recipients: {to: recipients.to, cc: recipients.cc},
    log: appendLog_(logsSheet, obj.id, user.email, isResend ? 'RESEND_REQUEST' : 'SEND_REQUEST', detail),
    attachmentBytes: wordBlob.getBytes().length
  };
}

function sendWordToApplicant_(user, requestId) {
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const sheet = ss.getSheetByName(CONFIG.REQUESTS_SHEET);
  const logsSheet = ss.getSheetByName(CONFIG.LOGS_SHEET);
  if (!sheet || !logsSheet) throw new Error('找不到 Requests 或 Logs 工作表');
  const table = readRequestsTable_(sheet);
  const index = findRequestIndex_(table, safeString_(requestId, 100));
  if (index < 0) throw new Error('找不到案件：' + requestId);
  const obj = rowToRequest_(table.rows[index], table.map, []);
  if (!obj.isExample) requireOwnerOrAdmin_(user, obj);
  const recipient = String(user.email || '').trim().toLowerCase();
  if (!recipient || !recipient.endsWith('@' + ALLOWED_DOMAIN)) throw new Error('目前登入者信箱不是有效的公司信箱');
  const fileName = safeFileName_(obj.id + '｜' + (obj.data.name || '設計需求')) + '.docx';
  const wordBlob = buildLeanRequestDocx_(obj, fileName);
  const subject = '【設計需求｜Word 附件】' + obj.id + '｜' + (obj.data.name || '未命名需求');
  const body = ['您好，', '', '附件為此案件目前版本的 Word 需求表。', '', '案件編號：' + obj.id, '需求名稱：' + (obj.data.name || ''), '案件狀態：' + (obj.status || ''), '', '謝謝您。', 'PATRONI 平面設計需求系統', '', '此信件由平面設計需求系統自動發送。'].join('\n');
  MailApp.sendEmail({to: recipient, subject: subject, body: body, attachments: [wordBlob], name: 'PATRONI 平面設計需求系統'});
  const detail = (obj.isExample ? '範例測試寄送最新版 Word 給自己：' : '寄送最新版 Word 給自己：') + recipient;
  return {recipient: recipient, log: appendLog_(logsSheet, obj.id, user.email, 'SEND_WORD', detail), attachmentBytes: wordBlob.getBytes().length};
}

function resendRequest_(user, payload) {
  payload = payload || {};
  const current = getRequest_(safeString_(payload.requestId, 100));
  if (current.isExample) throw appError_('FORBIDDEN', '範例案件不重新發送需求通知');
  requireOwnerOrAdmin_(user, current);
  payload.labels = Array.isArray(payload.labels) && payload.labels.length ? payload.labels : ['重新發送需求'];
  const updated = updateRequest_(user, payload);
  try {
    const mail = sendRequestNotificationFromObject_(user, updated.request, 'resend', updated.logsSheet);
    return {request: updated.request, summary: updated.summary, logs: updated.logs.concat([mail.log]), recipients: mail.recipients, attachmentBytes: mail.attachmentBytes, mailOk: true, mailError: ''};
  } catch (mailErr) {
    let failureLog = null;
    try { failureLog = appendLog_(updated.logsSheet, updated.request.id, user.email, 'SEND_FAILED', '重新發送通知失敗：' + safeString_(mailErr.message || String(mailErr), 500)); } catch (logErr) {}
    return {request: updated.request, summary: updated.summary, logs: updated.logs.concat(failureLog ? [failureLog] : []), recipients: {to:'', cc:[]}, attachmentBytes: 0, mailOk: false, mailError: mailErr.message || String(mailErr)};
  }
}

function deleteRequest_(user, requestId) {
  requestId = safeString_(requestId, 100);
  if (!requestId) throw new Error('Missing requestId');
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const sheet = ss.getSheetByName(CONFIG.REQUESTS_SHEET);
  const logsSheet = ss.getSheetByName(CONFIG.LOGS_SHEET);
  if (!sheet || !logsSheet) throw new Error('找不到 Requests 或 Logs 工作表');
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const table = readRequestsTable_(sheet);
    const index = findRequestIndex_(table, requestId);
    if (index < 0) throw new Error('找不到案件：' + requestId);
    const obj = rowToRequest_(table.rows[index], table.map, []);
    if (obj.isExample) throw appError_('FORBIDDEN', '範例案件不可刪除');
    requireOwnerOrAdmin_(user, obj);
    if (obj.docId) Drive.Files.remove(obj.docId);
    const logLast = logsSheet.getLastRow();
    if (logLast >= 2) {
      const logs = logsSheet.getRange(2, 1, logLast - 1, 5).getValues();
      const keep = logs.filter(function(r) { return String(r[0] || '') !== requestId; });
      logsSheet.getRange(2, 1, logLast - 1, 5).clearContent();
      if (keep.length) logsSheet.getRange(2, 1, keep.length, 5).setValues(keep);
    }
    sheet.deleteRow(index + 2);
    invalidateRequestCaches_(requestId);
    return {requestId: requestId};
  } finally {
    lock.releaseLock();
  }
}

function base64UrlEncodeText_(text) {
  return Utilities.base64EncodeWebSafe(Utilities.newBlob(String(text)).getBytes()).replace(/=+$/,'');
}

function base64UrlDecodeText_(text) {
  return Utilities.newBlob(Utilities.base64DecodeWebSafe(String(text))).getDataAsString();
}

function sessionSecret_() {
  if (AUTH_SECRET_MEMO_) return AUTH_SECRET_MEMO_;
  const props = PropertiesService.getScriptProperties();
  let secret = props.getProperty('AUTH_SESSION_SECRET_V1');
  if (!secret) {
    const lock = LockService.getScriptLock();
    lock.waitLock(10000);
    try {
      secret = props.getProperty('AUTH_SESSION_SECRET_V1');
      if (!secret) {
        secret = Utilities.getUuid().replace(/-/g,'') + Utilities.getUuid().replace(/-/g,'') + Utilities.getUuid().replace(/-/g,'');
        props.setProperty('AUTH_SESSION_SECRET_V1', secret);
      }
    } finally {
      lock.releaseLock();
    }
  }
  AUTH_SECRET_MEMO_ = secret;
  return secret;
}

function secureEqual_(a, b) {
  a = String(a || '');
  b = String(b || '');
  if (a.length !== b.length) return false;
  let diff = 0;
  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

function signSessionPart_(payloadPart) {
  return Utilities.base64EncodeWebSafe(
    Utilities.computeHmacSha256Signature(String(payloadPart), sessionSecret_())
  ).replace(/=+$/,'');
}

function createAuthSession_(user) {
  validateUser_(user);
  const payload = {
    v: 1,
    exp: Math.floor(Date.now() / 1000) + CONFIG.AUTH_SESSION_SECONDS,
    sub: safeString_(user.sub, 200),
    name: safeString_(user.name, 300),
    email: safeString_(user.email, 320).toLowerCase()
  };
  const part = base64UrlEncodeText_(JSON.stringify(payload));
  return part + '.' + signSessionPart_(part);
}

function readAuthSession_(sessionToken) {
  if (!sessionToken || typeof sessionToken !== 'string') return null;
  const parts = sessionToken.split('.');
  if (parts.length !== 2 || !parts[0] || !parts[1]) return null;
  if (!secureEqual_(signSessionPart_(parts[0]), parts[1])) return null;
  let payload;
  try { payload = JSON.parse(base64UrlDecodeText_(parts[0])); } catch (err) { return null; }
  if (!payload || payload.v !== 1 || Number(payload.exp || 0) <= Math.floor(Date.now() / 1000)) return null;
  const user = {sub: payload.sub || '', name: payload.name || '', email: payload.email || ''};
  try { validateUser_(user); } catch (err) { return null; }
  return user;
}


function authenticate_(body) {
  body = body && typeof body === 'object' ? body : {};
  const existing = readAuthSession_(body.sessionToken);
  if (existing) return {user: existing, sessionToken: createAuthSession_(existing)};
  if (!body.credential) throw appError_('AUTH_REQUIRED', '登入已逾時，請重新登入。');
  let token;
  try { token = verifyGoogleUser_(body.credential); } catch (err) { throw appError_('AUTH_REQUIRED', 'Google 登入已失效，請重新登入。'); }
  const user = userFromToken_(token);
  validateUser_(user);
  return {user: user, sessionToken: createAuthSession_(user)};
}

function verifyGoogleUser_(credential) {
  if (!credential) throw appError_('AUTH_REQUIRED', '缺少 Google 登入憑證');
  const cache = CacheService.getScriptCache();
  const key = 'google-user-' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, credential)).slice(0, 40);
  const cached = cache.get(key);
  if (cached) try { return JSON.parse(cached); } catch (err) {}
  const response = UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(credential), {muteHttpExceptions: true});
  if (response.getResponseCode() !== 200) throw appError_('AUTH_REQUIRED', 'Google 登入憑證已失效');
  let token;
  try { token = JSON.parse(response.getContentText()); } catch (err) { throw appError_('AUTH_REQUIRED', 'Google 登入驗證回應無效'); }
  if (token.aud !== GOOGLE_CLIENT_ID) throw appError_('AUTH_REQUIRED', 'Google 登入來源不符');
  if (token.iss !== 'accounts.google.com' && token.iss !== 'https://accounts.google.com') throw appError_('AUTH_REQUIRED', 'Google 登入簽發來源不符');
  if (token.email_verified !== true && token.email_verified !== 'true') throw appError_('AUTH_REQUIRED', 'Google 信箱尚未驗證');
  if (token.hd !== ALLOWED_DOMAIN) throw appError_('AUTH_REQUIRED', 'Google Workspace 網域不符');
  if (!token.email || !token.email.toLowerCase().endsWith('@' + ALLOWED_DOMAIN)) throw appError_('AUTH_REQUIRED', '公司信箱網域不符');
  if (!token.sub) throw appError_('AUTH_REQUIRED', 'Google 帳戶識別資料不完整');
  const now = Math.floor(Date.now() / 1000);
  const exp = Number(token.exp || 0);
  if (!exp || exp <= now) throw appError_('AUTH_REQUIRED', 'Google 登入憑證已逾時');
  const ttl = Math.max(1, Math.min(1800, exp - now));
  cache.put(key, JSON.stringify(token), ttl);
  return token;
}

function userFromToken_(token) {
  return {sub: token.sub, name: token.name || token.email.split('@')[0], email: token.email};
}

function doGet() {
  return jsonResponse_({
    ok: true,
    service: 'PATRONI Graphic Design Request API',
    apiVersion: '2026-09-auth-v2',
    timestamp: new Date().toISOString()
  });
}

function doPost(e) {
  try {
    const raw = e && e.postData && e.postData.contents ? e.postData.contents : '{}';
    if (raw.length > CONFIG.MAX_BODY_CHARS) throw appError_('PAYLOAD_TOO_LARGE', 'Request payload too large');
    let body;
    try { body = JSON.parse(raw); } catch (err) { throw appError_('INVALID_JSON', 'Request payload is not valid JSON'); }
    if (!body || typeof body !== 'object' || Array.isArray(body)) throw appError_('INVALID_REQUEST', 'Invalid request payload');
    if (!body.action) throw appError_('INVALID_REQUEST', 'Missing action');
    if (body.action === 'logout') return jsonResponse_({ok: true});
    const auth = authenticate_(body);
    const user = auth.user;
    if (body.action === 'whoAmI') return jsonResponse_({ok: true, user: {name: user.name || '', email: user.email, isAdmin: isAdmin_(user)}, sessionToken: auth.sessionToken});
    if (body.action === 'listRequests') {
      return jsonResponse_({ok: true, user: {name: user.name || '', email: user.email, isAdmin: isAdmin_(user)}, requests: listRequests_(), serverNow: new Date().toISOString(), sessionToken: auth.sessionToken});
    }
    if (body.action === 'getRequest') {
      return jsonResponse_({ok: true, request: getRequest_(body.requestId), sessionToken: auth.sessionToken});
    }
    if (body.action === 'updateRequest') {
      const result = withIdempotency_('updateRequest', user, body.operationId, function() { return updateRequest_(user, body); });
      return jsonResponse_({
        ok: true,
        request: result.request,
        summary: result.summary,
        logs: result.logs,
        documentUpdated: result.documentUpdated,
        exampleRestored: !!result.exampleRestored,
        restoredFields: result.restoredFields || [],
        sessionToken: auth.sessionToken
      });
    }
    if (body.action === 'resendRequest') {
      const result = withIdempotency_('resendRequest', user, body.operationId, function() { return resendRequest_(user, body); });
      return jsonResponse_({ok: true, request: result.request, summary: result.summary, logs: result.logs, recipients: result.recipients, attachmentBytes: result.attachmentBytes, mailOk: result.mailOk, mailError: result.mailError, sessionToken: auth.sessionToken});
    }
    if (body.action === 'sendWordToApplicant') {
      const result = withIdempotency_('sendWordToApplicant', user, body.operationId, function() { return sendWordToApplicant_(user, body.requestId); });
      return jsonResponse_({ok: true, recipient: result.recipient, log: result.log, attachmentBytes: result.attachmentBytes, sessionToken: auth.sessionToken});
    }
    if (body.action === 'deleteRequest') {
      const result = withIdempotency_('deleteRequest', user, body.operationId, function() { return deleteRequest_(user, body.requestId); });
      return jsonResponse_({ok: true, requestId: result.requestId, sessionToken: auth.sessionToken});
    }
    if (body.action === 'createRequest') {
      const core = withIdempotency_('createRequest', user, body.operationId, function() {
        const result = createRequest_(user, body.data, body.operationId);
        let mailOk = true, mailError = '', recipients = {to:'', cc:[]}, attachmentBytes = 0;
        if (result.duplicate) return {requestId: result.requestId, docId: result.docId, docUrl: result.docUrl, mailOk: true, mailError: '', recipients: {to:'', cc:[]}, attachmentBytes: 0, duplicate: true};
        try {
          const mail = sendRequestNotificationFromObject_(user, result.request, 'new', result.logsSheet);
          recipients = mail.recipients;
          attachmentBytes = mail.attachmentBytes;
        } catch (mailErr) {
          mailOk = false;
          mailError = mailErr.message || String(mailErr);
          try { appendLog_(result.logsSheet, result.requestId, user.email, 'SEND_FAILED', '新需求通知失敗：' + safeString_(mailError, 500)); } catch (logErr) {}
          console.error(mailErr);
        }
        return {requestId: result.requestId, docId: result.docId, docUrl: result.docUrl, mailOk: mailOk, mailError: mailError, recipients: recipients, attachmentBytes: attachmentBytes};
      });
      core.sessionToken = auth.sessionToken;
      core.ok = true;
      return jsonResponse_(core);
    }
    throw appError_('UNSUPPORTED_ACTION', 'Unsupported action');
  } catch (err) {
    console.error(err);
    return jsonResponse_({ok: false, error: err.message || String(err), code: err.code || 'SERVER_ERROR'});
  }
}
