function operationCacheKey_(scope, email, operationId) {
  if (!operationId) return '';
  const raw = String(scope || '') + '|' + String(email || '').toLowerCase() + '|' + String(operationId || '');
  return 'op-' + Utilities.base64EncodeWebSafe(
    Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, raw)
  ).replace(/=+$/,'').slice(0, 43);
}

function withIdempotency_(scope, user, operationId, fn) {
  operationId = safeString_(operationId, 120);
  if (!operationId) return fn();
  const cache = CacheService.getScriptCache();
  const key = operationCacheKey_(scope, user.email, operationId);
  const cached = cache.get(key);
  if (cached) {
    try { return JSON.parse(cached); } catch (err) { cache.remove(key); }
  }
  const result = fn();
  try { cache.put(key, JSON.stringify(result), CONFIG.IDEMPOTENCY_SECONDS); } catch (err) {}
  return result;
}

